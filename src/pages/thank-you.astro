---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title={"Thank You | Bleufoot Solutions"}
  description={"Your request has been received by Bleufoot Solutions."}
  robots={"noindex, follow"}
>
<main>
<section class="page-hero">
<div class="container page-hero-grid">
<div>
<div class="eyebrow">
<h4>Request received</h4>
</div>
<h1>
            Thank you. Your request has been received.
          </h1>
<p>
            Bleufoot Solutions will review your message and follow up with you within one to two business days.
          </p>
<div class="hero-actions">
<a class="btn btn-primary" href="/">
              Return Home →
            </a>
<a class="btn btn-secondary" href="/services">
              Explore Services
            </a>
</div>
</div>
<div class="hero-panel">
<ul>
<li>Your request was submitted successfully</li>
<li>Your message will be reviewed</li>
<li>We will contact you using the information provided</li>
<li>No additional action is required</li>
</ul>
</div>
</div>
</section>
</main>
</BaseLayout>
