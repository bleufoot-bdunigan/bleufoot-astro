<BaseLayout
  title={"Managed IT Services & IT Consulting in Austin | Bleufoot"}
  description={"Bleufoot Solutions provides managed IT services, IT consulting, cybersecurity, cloud infrastructure, and network support for businesses in Austin, Texas."}
  canonical={"https://www.bleufoot.com/"}
  robots={"index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
  activePage={"home"}
  openGraph={{"title": "Managed IT Services & IT Consulting in Austin | Bleufoot", "description": "Managed IT services, strategic IT consulting, cybersecurity, cloud infrastructure, and network support for Austin businesses.", "url": "https://www.bleufoot.com/", "image": "https://www.bleufoot.com/assets/img/og-image.png", "imageType": "image/png", "imageWidth": "1200", "imageHeight": "630", "imageAlt": "Bleufoot Solutions technology services"}}
