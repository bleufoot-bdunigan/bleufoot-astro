<BaseLayout
  title={"Cloud & Infrastructure Services in Austin | Bleufoot"}
  description={"Cloud and infrastructure services for Austin businesses, including servers, virtualization, hybrid environments, monitoring, applications, backups, and recovery."}
  canonical={"https://www.bleufoot.com/infrastructure"}
  robots={"index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
  activePage="services"
  openGraph={{"title": "Cloud & Infrastructure Services in Austin | Bleufoot", "description": "Cloud and infrastructure services including servers, virtualization, hybrid environments, monitoring, applications, backups, and recovery.", "url": "https://www.bleufoot.com/infrastructure", "image": "https://www.bleufoot.com/assets/img/og-image.png", "imageType": "image/png", "imageWidth": "1200", "imageHeight": "630", "imageAlt": "Bleufoot Solutions technology services"}}
