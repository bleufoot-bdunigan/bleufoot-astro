---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title={"Page Not Found | Bleufoot Solutions"}
  description={"The requested page could not be found on the Bleufoot Solutions website."}
  robots={"noindex, follow"}
>
<main>
<section class="page-hero">
<div class="container page-hero-grid">
<div>
<div class="eyebrow">
<h4>404 Error</h4>
</div>
<h1>
            We could not find that page.
          </h1>
<p>
            The page may have moved, the link may be outdated,
            or the address may have been entered incorrectly.
          </p>
<div class="hero-actions">
<a class="btn btn-primary" href="/">
              Return Home →
            </a>
<a class="btn btn-secondary" href="/services">
              Explore Services
            </a>
</div>
</div>
<div class="hero-panel">
<h3>Looking for something specific?</h3>
<ul>
<li>Review Bleufoot technology services</li>
<li>Learn more about our approach</li>
<li>Contact us with a question</li>
<li>Request a consultation</li>
</ul>
<div class="hero-actions">
<a class="btn btn-light" href="/contact">
              Contact Bleufoot →
            </a>
</div>
</div>
</div>
</section>
</main>
</BaseLayout>
