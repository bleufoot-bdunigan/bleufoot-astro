---
import BaseLayout from './BaseLayout.astro';

const { post } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  category,
  tags,
  heroImage,
  heroAlt,
} = post.data;

const canonical = `https://www.bleufoot.com/blog/${post.id}`;

const publishedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const modifiedDate = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    '@type': 'Organization',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Bleufoot Solutions',
    url: 'https://www.bleufoot.com',
  },
  mainEntityOfPage: canonical,
  image: heroImage
    ? `https://www.bleufoot.com${heroImage}`
    : 'https://www.bleufoot.com/assets/img/og-image.png',
};
---

<BaseLayout
  title={`${title} | Bleufoot Solutions`}
  description={description}
  canonical={canonical}
  activePage="blog"
  structuredData={structuredData}
  pageStylesheet="/assets/css/blog.css"
  openGraph={{
    title,
    description,
    url: canonical,
    image: heroImage
      ? `https://www.bleufoot.com${heroImage}`
      : undefined,
    imageAlt: heroAlt ?? title,
  }}
>
  <main>
    <article class="blog-post">
      <header class="blog-post-header">
        <div class="container blog-post-header-inner">
          <a class="blog-back-link" href="/blog">← Back to Insights</a>

          <p class="blog-category">{category}</p>

          <h1>{title}</h1>

          <p class="blog-description">{description}</p>

          <div class="blog-meta">
            <span>{author}</span>
            <span aria-hidden="true">•</span>
            <time datetime={pubDate.toISOString()}>
              {publishedDate}
            </time>

            {
              updatedDate && (
                <>
                  <span aria-hidden="true">•</span>
                  <span>Updated {modifiedDate}</span>
                </>
              )
            }
          </div>
        </div>
      </header>

      {
        heroImage && (
          <div class="container blog-hero-image">
            <img
              src={heroImage}
              alt={heroAlt ?? ''}
              width="1200"
              height="630"
            />
          </div>
        )
      }

      <div class="container blog-article-container">
        <div class="blog-content">
          <slot />
        </div>

        {
          tags.length > 0 && (
            <footer class="blog-tags">
              <strong>Topics:</strong>

              <ul>
                {tags.map((tag: string) => <li>{tag}</li>)}
              </ul>
            </footer>
          )
        }
      </div>
    </article>

    <section class="blog-cta">
      <div class="container">
        <h2>Need help with your technology strategy?</h2>

        <p>
          Bleufoot Solutions provides technology consulting, managed services,
          cloud infrastructure, networking, and cybersecurity services
          throughout Austin and Central Texas.
        </p>

        <a class="btn primary" href="/quote-request">
          Request a Consultation →
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
