---
interface Props {
  activePage?: 'home' | 'services' | 'about' | 'blog' | 'contact';
}

const { activePage } = Astro.props;
---

<header class="topbar">
  <div class="container nav">
    <a
      class="logo-link"
      href="/"
      aria-label="Bleufoot Solutions home"
    >
      <img
        class="logo"
        src="/assets/img/logo.svg"
        alt="Bleufoot Solutions"
      />
    </a>

    <button
      class="mobile-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      aria-label="Open navigation"
    >
      <span aria-hidden="true"></span>
    </button>

    <ul id="primary-navigation" class="nav-menu">
      <li>
        <a
          href="/"
          class:list={{ active: activePage === 'home' }}
          aria-current={activePage === 'home' ? 'page' : undefined}
        >
          Home
        </a>
      </li>

      <li>
        <button
          class:list={[
            'drop-toggle',
            { active: activePage === 'services' },
          ]}
          type="button"
          aria-expanded="false"
          aria-controls="services-dropdown"
        >
          Services
          <span aria-hidden="true">⌄</span>
        </button>

        <div id="services-dropdown" class="dropdown">
          <a href="/services">
            Services Overview
          </a>

          <a href="/consulting">
            Strategic Technology Consulting
          </a>

          <a href="/managed-services">
            Managed Technology Services
          </a>

          <a href="/infrastructure">
            Cloud &amp; Infrastructure
          </a>

          <a href="/network-services">
            Network Services
          </a>

          <a href="/cybersecurity">
            Cybersecurity Services
          </a>
        </div>
      </li>

      <li>
        <a
          href="/about"
          class:list={{ active: activePage === 'about' }}
          aria-current={activePage === 'about' ? 'page' : undefined}
        >
          About
        </a>
      </li>

      <li>
        <a
          href="/blog"
          class:list={{ active: activePage === 'blog' }}
          aria-current={activePage === 'blog' ? 'page' : undefined}
        >
          Insights
        </a>
      </li>

      <li>
        <a
          href="/contact"
          class:list={{ active: activePage === 'contact' }}
          aria-current={activePage === 'contact' ? 'page' : undefined}
        >
          Contact
        </a>
      </li>
    </ul>

    <a class="nav-cta" href="/quote-request">
      Request a Consultation →
    </a>
  </div>
</header>
